<!-- 主题：亮色浅色（白天办公，文字黑色） -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBg" Color="#F5F5F5" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBgHover" Color="#EBEBEB" />
    <SolidColorBrush x:Key="NavBg" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Line" Color="#D0D0D0" />
    <SolidColorBrush x:Key="Fg" Color="#000000" />
    <SolidColorBrush x:Key="FgDim" Color="#1F1F1F" />
    <SolidColorBrush x:Key="FgFaint" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Accent" Color="#2F6FDB" />
    <SolidColorBrush x:Key="AccentDim" Color="#D5E2F8" />
    <SolidColorBrush x:Key="Ok" Color="#12A06E" />
    <SolidColorBrush x:Key="Warn" Color="#C98A00" />
    <SolidColorBrush x:Key="Ng" Color="#D64545" />
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelBg" Color="#C9DCFA" />
    <SolidColorBrush x:Key="CardSubFg" Color="#000000" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
</ResourceDictionary>
