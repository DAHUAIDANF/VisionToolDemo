<Window x:Class="VisionToolDemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionTool 视觉检测工作台" Background="{DynamicResource Bg}"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 合并应用级样式：VS 设计器单独打开本窗口也能解析 NavBg/PageHeader/WinButton 等（运行时由 Program.cs 合并，重复合并无害） -->
                <ResourceDictionary Source="/VisionToolDemo;component/Wpf/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 自绘标题栏（颜色跟随主题：NavBg 动态资源） ============ -->
        <Border Grid.Row="0" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="10,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <!-- 标题栏用 Grid 三列定位：第 3 列右对齐 = 按钮固定钉在窗口右上角（DockPanel 依赖 Dock 附加属性，
                 个别环境/缩放下可能表现不一致，换成显式 Grid 列更确定）。 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="VisionTool 视觉检测工作台" VerticalAlignment="Center"
                           Style="{StaticResource PageHeader}" Margin="2,0,12,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 系统按钮用矢量 Path 图形（不依赖 Segoe MDL2 Assets 字体：字体缺失时字符渲染为空白/方块）。
                         最小化=横线，最大化=方框，关闭=叉；Stroke 跟随按钮前景色（含关闭键悬停变白）。 -->
                    <Button x:Name="BtnWinMin" Style="{StaticResource WinButton}" Tag="min" Command="{Binding WindowCommand}" CommandParameter="min" ToolTip="最小化">
                        <Viewbox Width="13" Height="13" Stretch="Uniform">
                            <Path Data="M4,11 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnWinMax" Style="{StaticResource WinButton}" Tag="max" Command="{Binding WindowCommand}" CommandParameter="max" ToolTip="最大化/还原">
                        <Viewbox Width="13" Height="13" Stretch="Uniform">
                            <Path Data="M4,4 H12 V12 H4 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnWinClose" Style="{StaticResource WinButton}" Tag="close" Command="{Binding WindowCommand}" CommandParameter="close" ToolTip="关闭">
                        <Viewbox Width="13" Height="13" Stretch="Uniform">
                            <Path Data="M4,4 L12,12 M12,4 L4,12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航（宽度固定按 DIP，DPI 变化时自动等比缩放） ============ -->
        <Border Grid.Column="0" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,10">
                    <TextBlock Text="v0.1" FontSize="11" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="NavHost" Margin="0,10,0,0">
                    <RadioButton x:Name="NavAutomation" Style="{StaticResource NavButton}" Tag="&#xE7C3;" Content="工作流" Command="{Binding NavigateCommand}" CommandParameter="automation" />
                    <RadioButton x:Name="NavPipeline" Style="{StaticResource NavButton}" Tag="&#xE8B7;" Content="视觉" Command="{Binding NavigateCommand}" CommandParameter="pipeline" />
                    <RadioButton x:Name="NavCapture" Style="{StaticResource NavButton}" Tag="&#xE786;" Content="采集" Command="{Binding NavigateCommand}" CommandParameter="capture" />
                    <RadioButton x:Name="NavCatalog" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="算子" Command="{Binding NavigateCommand}" CommandParameter="catalog" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="记录" Command="{Binding NavigateCommand}" CommandParameter="history" />
                    <RadioButton x:Name="NavHelp" Style="{StaticResource NavButton}" Tag="&#xE897;" Content="说明" Command="{Binding NavigateCommand}" CommandParameter="help" />
                    <RadioButton x:Name="NavTrain" Style="{StaticResource NavButton}" Tag="&#xE8A5;" Content="训练" Command="{Binding NavigateCommand}" CommandParameter="train" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="设置" Command="{Binding NavigateCommand}" CommandParameter="settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 顶部工具栏 ============ -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Text="{Binding Title}" Style="{StaticResource PageHeader}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel x:Name="ToolHost" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" />
                    <TextBlock x:Name="SubTitleText" Style="{StaticResource DimText}" VerticalAlignment="Center" Text="{Binding SubTitle}" />
                </DockPanel>
            </Border>

            <!-- ============ 内容区（页面自己撑满，Grid 自动适应任意分辨率） ============ -->
            <ContentControl Grid.Row="1" x:Name="PageHost" />

            <!-- ============ 底部状态栏：分辨率 / DPI / 倍率 一眼可见 ============ -->
            <Border Grid.Row="2" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Style="{StaticResource FaintText}" VerticalAlignment="Center" Text="{Binding ScreenInfo}" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource FaintText}" VerticalAlignment="Center" Text="{Binding Status}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
        </Grid>
</Window>