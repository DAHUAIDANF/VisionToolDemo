<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 颜色 =================
         对比度按 WCAG 大致核过（正文 ≥ 7:1，次要文字 ≥ 4.5:1，深色底上小字也必须看得清）：
           Fg      #F4F7FB on Bg #1A1E24  ≈ 15:1
           FgDim   #BFC8D6 on Bg          ≈ 9:1
           FgFaint #9AA5B4 on Bg          ≈ 5.6:1  ← 12px 小字的最低档（原来是 3:1，看不清就是它）
         另外把描边 Line 提亮，卡片底色提亮，让"卡片/输入框"边界一眼能分辨。 -->
    <SolidColorBrush x:Key="Bg" Color="#1A1E24" />
    <SolidColorBrush x:Key="PanelBg" Color="#1F242C" />
    <SolidColorBrush x:Key="CardBg" Color="#333C4B" />
    <SolidColorBrush x:Key="CardBgHover" Color="#3E4959" />
    <SolidColorBrush x:Key="NavBg" Color="#12161C" />
    <SolidColorBrush x:Key="Line" Color="#4A5666" />
    <SolidColorBrush x:Key="Fg" Color="#F6F9FD" />
    <SolidColorBrush x:Key="FgDim" Color="#CBD4E0" />
    <SolidColorBrush x:Key="FgFaint" Color="#B4BFCE" />
    <SolidColorBrush x:Key="Accent" Color="#4C8DF6" />
    <SolidColorBrush x:Key="AccentDim" Color="#20304A" />
    <SolidColorBrush x:Key="Ok" Color="#45DEA8" />
    <SolidColorBrush x:Key="Warn" Color="#FFC94A" />
    <SolidColorBrush x:Key="Ng" Color="#FF8A8A" />
    <SolidColorBrush x:Key="InputBg" Color="#10151B" />
    <SolidColorBrush x:Key="SelBg" Color="#40506B" />
    <!-- 卡片里"内容行"的文字：密集小列表要一眼能读，别用太淡的灰 -->
    <SolidColorBrush x:Key="CardSubFg" Color="#D3DBE6" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />   <!-- 强调色背景上的文字：默认白，随主题切换 -->

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, monospace</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

    <!-- ================= 文本 ================= -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="DimText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FaintText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MonoText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>

    <!-- 列表卡片：标题与副标题（节点库/算子库/运行记录都用它，保证同一档可读性） -->
    <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CardSub" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource CardSubFg}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- 页面顶栏大标题（与训练页顶栏一致的页头视觉：各页面统一） -->
    <Style x:Key="PageHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Margin" Value="0,2,0,6" />
    </Style>

    <!-- ================= 按钮 ================= -->
    <Style x:Key="FlatButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 开关按钮（ToggleButton）：外观与 FlatButton 一致，另加勾选态高亮（IsChecked 时 Accent 边框+底色）。
         注意：ToggleButton 不能直接套 TargetType=Button 的 FlatButton 样式，WPF 运行期会抛
         “设置属性 FrameworkElement.Style 时引发异常”，必须单独定义本样式。 -->
    <Style x:Key="FlatToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="WinButton" TargetType="{x:Type Button}">
        <!-- 系统按钮图标字符在 Segoe MDL2 Assets 里（最小化/最大化/关闭）；用微软雅黑会显示方块 -->
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgHover}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="close" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 分类筛选胶囊（节点库/算子库的分类按钮） -->
    <Style x:Key="Chip" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="4,8" Margin="4,2">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- 导航图标：矢量 Path 按 Tag 切换（不依赖 Segoe MDL2 Assets 字体，字体缺失也保证显示）。
                                 每个 Path 用 Viewbox 固定 18x18，Stroke 跟随按钮前景色。 -->
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas>
                                    <!-- 工作流：两个节点+连线 -->
                                    <Path x:Name="GlyphAutomation" Data="M2,2 H6 V6 H2 Z M10,10 H14 V14 H10 Z M6,4 H10 M4,6 V10 M10,4 V10"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" />
                                    <!-- 视觉：图像框+山 -->
                                    <Path x:Name="GlyphPipeline" Data="M2,2 H14 V14 H2 Z M2,9 L6,5 L10,9 M10,7 L12,9"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Visibility="Collapsed" />
                                    <!-- 算子：文件夹 -->
                                    <Path x:Name="GlyphCatalog" Data="M2,3 H6 L7,5 H14 V13 H2 Z"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Visibility="Collapsed" />
                                    <!-- 记录：时钟 -->
                                    <Path x:Name="GlyphHistory" Data="M8,2 A6,6 0 1 1 8,14 A6,6 0 1 1 8,2 M8,5 V8 L10.5,9.5"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Visibility="Collapsed" />
                                    <!-- 说明：帮助（圆+信息点） -->
                                    <Path x:Name="GlyphHelp" Data="M8,2 A6,6 0 1 1 8,14 A6,6 0 1 1 8,2 M8,6.5 V8 M8,10.2 H8.01"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Visibility="Collapsed" />
                                    <!-- 训练：书本 -->
                                    <Path x:Name="GlyphTrain" Data="M2,3 H6 V13 H2 Z M6,3 H14 V13 H6 Z M6,6 H14 M6,9 H14"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Visibility="Collapsed" />
                                    <!-- 设置：准星（十字+圆） -->
                                    <Path x:Name="GlyphSettings" Data="M8,3 V13 M3,8 H13 M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Visibility="Collapsed" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11.5"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="pipeline"><Setter TargetName="GlyphPipeline" Property="Visibility" Value="Visible" /><Setter TargetName="GlyphAutomation" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Tag" Value="catalog"><Setter TargetName="GlyphCatalog" Property="Visibility" Value="Visible" /><Setter TargetName="GlyphAutomation" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Tag" Value="history"><Setter TargetName="GlyphHistory" Property="Visibility" Value="Visible" /><Setter TargetName="GlyphAutomation" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Tag" Value="help"><Setter TargetName="GlyphHelp" Property="Visibility" Value="Visible" /><Setter TargetName="GlyphAutomation" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Tag" Value="train"><Setter TargetName="GlyphTrain" Property="Visibility" Value="Visible" /><Setter TargetName="GlyphAutomation" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Tag" Value="settings"><Setter TargetName="GlyphSettings" Property="Visibility" Value="Visible" /><Setter TargetName="GlyphAutomation" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 输入控件 ================= -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <!-- VerticalAlignment 绑定 VerticalContentAlignment：训练页输入框 Height=28 时文字垂直居中、
                             不被上下边距裁切（自定义模板默认不继承该属性） -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 复选框：默认模板是浅色的，配上浅色文字就看不清，这里换成深色自绘 -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1.5" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 2 7 L 6 11 L 13 3" Stroke="{DynamicResource Ok}"
                                  StrokeThickness="2.2" Visibility="Collapsed"
                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ok}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉框：默认模板浅底 + 我设的浅色前景 = 看不清，这里换成深色自绘（含弹出列表） -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" />
                        <Grid Margin="9,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 非编辑模式：显示选中项（SelectionBoxItem） -->
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <!-- 编辑模式（IsEditable=True，如训练页标签输入框）：WPF 约定 PART_EditableTextBox 为可输入区，
                                 模板必须提供它，否则可编辑下拉框无法输入文字。默认隐藏，IsEditable 时显示 -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                                     SelectionBrush="{DynamicResource Accent}" />
                            <Path Grid.Column="1" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="{DynamicResource FgDim}"
                                  StrokeThickness="1.8" VerticalAlignment="Center" />
                        </Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 进度条：默认浅色，改成深色轨道 + 亮色指示条 -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}" RadiusX="3" RadiusY="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 提示气泡：默认浅底，这里深底浅字 -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 容器 ================= -->
    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="Panel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource PanelBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{DynamicResource Line}" />
        <Setter Property="ShowsPreview" Value="True" />
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ================= 列表 / 标签页 ================= -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- 默认 ListBoxItem：选中时用深蓝底 + 白字（默认的浅蓝底 + 白字在深色主题里也不难看，但统一一下） -->
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6,6,0,0" Padding="13,7" Margin="0,0,4,0">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 训练页原型同款：步骤胶囊 / 统计格 -->
    <Style x:Key="StepPill" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style x:Key="StepText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
    </Style>
    <Style x:Key="StatCell" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

</ResourceDictionary>
