<UserControl x:Class="VisionToolDemo.Wpf.Views.CatalogPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
    <DockPanel>
        <Border Classes="card" DockPanel.Dock="Top" Padding="12" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="算子目录" Classes="pageheader" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="主题" Classes="dimtext" VerticalAlignment="Center" Margin="20,0,10,0" />
                    <Border x:Name="ThemeDot0" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                            ToolTip.Tip="深蓝灰（默认）" PointerPressed="ThemeDot_Click" Tag="0" />
                    <Border x:Name="ThemeDot1" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                            ToolTip.Tip="深墨绿" PointerPressed="ThemeDot_Click" Tag="1" />
                    <Border x:Name="ThemeDot2" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                            ToolTip.Tip="深紫罗兰" PointerPressed="ThemeDot_Click" Tag="2" />
                    <Border x:Name="ThemeDot3" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                            ToolTip.Tip="暖橙红" PointerPressed="ThemeDot_Click" Tag="3" />
                    <Border x:Name="ThemeDot4" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                            ToolTip.Tip="亮色浅色" PointerPressed="ThemeDot_Click" Tag="4" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="全部算子与节点" Classes="sectionheader" />
                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Classes="fainttext" Margin="0,0,0,6" Text="{Binding CountText}" />
                <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ItemsControl x:Name="Chips" DockPanel.Dock="Top" Margin="0,0,0,8" ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Text}" IsChecked="{Binding IsSelected}"
                                          Classes="chip"
                                          Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding Category}" Margin="0,0,6,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Classes="cardtitle" />
                                <TextBlock Text="{Binding Sub}" Classes="cardsub" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="#2AFFFFFF" ToolTip.Tip="拖动调整栏宽" />

        <Border Grid.Column="2" Classes="panel">
            <DockPanel Margin="14">
                <TextBlock x:Name="DetailTitle" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Text="{Binding CurrentDetail.Title}" />
                <TextBlock x:Name="DetailSub" DockPanel.Dock="Top" Classes="dimtext" Margin="0,4,0,10" Text="{Binding CurrentDetail.Sub}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailHost" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
    </DockPanel>
</UserControl>