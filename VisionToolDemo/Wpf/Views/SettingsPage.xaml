<UserControl x:Class="VisionToolDemo.Wpf.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">

        <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VisionToolDemo;component/Wpf/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageHeader}" Margin="0,0,0,10" />
            <TextBlock Text="显示与坐标" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="DisplayInfo" Style="{StaticResource DimText}" Text="{Binding InfoText}" />
                    <TextBlock Style="{StaticResource FaintText}" Margin="0,8,0,0"
                               Text="界面用 WPF 矢量渲染 + 自动布局：任意分辨率都不会挤压，125%/150% 缩放下文字与控件由系统按 DPI 等比放大，不发虚。程序已在清单里声明「每显示器 DPI 感知」，跨屏拖动会自动适配。" />
                </StackPanel>
            </Border>

            <TextBlock Text="界面主题" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="ThemeHint" Style="{StaticResource DimText}" Margin="0,0,0,10"
                               Text="切换界面配色，点击立即生效并自动保存（下次启动保持）。" />
                    <WrapPanel x:Name="ThemeHost" />
                </StackPanel>
            </Border>

            <TextBlock Text="自检（出问题时先跑这两个）" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnCoordTest" Content="坐标系自检（截图 vs 屏幕）" Style="{StaticResource PrimaryButton}" Command="{Binding CoordTestCommand}" />
                <Button x:Name="BtnMouseTest" Content="鼠标定位自检" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Command="{Binding MouseTestCommand}" />
                <Button x:Name="BtnClipboard" Content="复制报告" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Command="{Binding ClipboardCommand}" />
            </StackPanel>
            <TextBox x:Name="Report" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     Height="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource MonoFont}" Background="{DynamicResource InputBg}" Margin="0,0,0,14"
                     Text="{Binding ReportText}" />

            <TextBlock Text="目录" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnShotDir" Content="打开截图目录" Style="{StaticResource FlatButton}" Command="{Binding OpenShotDirCommand}" />
                <Button x:Name="BtnRecDir" Content="打开运行记录目录" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Command="{Binding OpenRecDirCommand}" />
            </StackPanel>
            <TextBlock x:Name="DirInfo" Style="{StaticResource FaintText}" Margin="0,10,0,0" Text="{Binding DirInfoText}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
