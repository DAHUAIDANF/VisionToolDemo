<UserControl x:Class="VisionToolDemo.Wpf.Views.TrainPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:VisionToolDemo.Wpf.Views"
             Background="{DynamicResource Bg}">

            <UserControl.Resources>
        <ResourceDictionary>
            <!-- 文件路径 → 缩略图（标注图片列表用，主流标注工具样式） -->
            <local:FileToImageConverter x:Key="FileImg" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14" MaxWidth="1280" HorizontalAlignment="Left" MinWidth="1060">

            <!-- ===== 顶栏：标题 + 步骤指示 + 主题切换 + 训练按钮组（同 prototype.html） ===== -->
            <Border Classes="card" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="深度学习训练台" Classes="pageheader" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- 主题切换：5 个主题色点（与设置页同源），点击即时应用 -->
                            <TextBlock Text="主题" Classes="dimtext" VerticalAlignment="Center" Margin="20,0,10,0" />
                            <Border x:Name="ThemeDot0" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                                     ToolTip.Tip="深蓝灰（默认）" PointerPressed="ThemeDot_Click" Tag="0" />
                            <Border x:Name="ThemeDot1" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                                     ToolTip.Tip="深墨绿" PointerPressed="ThemeDot_Click" Tag="1" />
                            <Border x:Name="ThemeDot2" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                                     ToolTip.Tip="深紫罗兰" PointerPressed="ThemeDot_Click" Tag="2" />
                            <Border x:Name="ThemeDot3" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                                     ToolTip.Tip="暖橙红" PointerPressed="ThemeDot_Click" Tag="3" />
                            <Border x:Name="ThemeDot4" Width="24" Height="24" Margin="7,0,0,0" CornerRadius="12" BorderThickness="2"
                                     ToolTip.Tip="亮色浅色" PointerPressed="ThemeDot_Click" Tag="4" />
                        </StackPanel>
                    </DockPanel>
                    <!-- 步骤指示：1数据集 2标注 3参数 4训练 5导出（当前步骤=4 高亮） -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Classes="steppill" x:Name="Step1"><TextBlock Text="1 数据集" Classes="steptext" /></Border>
                        <Border Classes="steppill" x:Name="Step2" Margin="6,0,0,0"><TextBlock Text="2 标注" Classes="steptext" /></Border>
                        <Border Classes="steppill" x:Name="Step3" Margin="6,0,0,0"><TextBlock Text="3 参数" Classes="steptext" /></Border>
                        <Border Classes="steppill" x:Name="Step4" Margin="6,0,0,0"><TextBlock Text="4 训练" Classes="steptext" /></Border>
                        <Border Classes="steppill" x:Name="Step5" Margin="6,0,0,0"><TextBlock Text="5 导出" Classes="steptext" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnTrain" Content="开始训练" Classes="flat primary" Height="30" Command="{Binding TrainCommand}" />
                        <Button x:Name="BtnStop" Content="停止" Classes="flat" Height="30" Margin="8,0,0,0" IsEnabled="{Binding IsTrainRunning}" Command="{Binding StopCommand}" />
                        <Button x:Name="BtnValidate" Content="验证一张图…" Classes="flat" Height="30" Margin="8,0,0,0" IsEnabled="{Binding IsModelReady}" Command="{Binding ValidateCommand}" />
                        <Button x:Name="BtnExport" Content="导出 ONNX…" Classes="flat" Height="30" Margin="8,0,0,0" IsEnabled="{Binding IsModelReady}" Command="{Binding ExportCommand}" />
                        <Button x:Name="BtnSaveModel" Content="保存模型(.vtmodel)" Classes="flat" Height="30" Margin="8,0,0,0" IsEnabled="{Binding IsModelReady}" Command="{Binding SaveModelCommand}" />
                        <Button x:Name="BtnLoadModel" Content="加载模型继续训练" Classes="flat" Height="30" Margin="8,0,0,0" Command="{Binding LoadModelCommand}"
                                ToolTip.Tip="选择之前保存的 .vtmodel：点「开始训练」会以它的权重继续训练（不重头开始）。" />
                    </StackPanel>
                    <TextBlock x:Name="TrainStatus" Classes="dimtext" Margin="0,8,0,0" Text="就绪" />
                </StackPanel>
            </Border>

            <!-- ===== 主区两栏：左=数据集/标注/参数，右=训练监控/混淆矩阵/日志（同 prototype.html） ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左列（内容超高，包 ScrollViewer：标注区较长时也能滚到 3 训练参数等下方区块） -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <StackPanel>
                    <!-- 1. 训练集目录 -->
                    <TextBlock Text="1 训练集目录" Classes="sectionheader" />
                    <Border Classes="card" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TrainDirBox" Height="34" FontSize="14"
                                         ToolTip.Tip="目录下每个子文件夹 = 一个类别，子文件夹名即类别名（如 red/ blue/）；若目录含 标注.json 则点「加载标注」按框选标签训练" />
                                <Button x:Name="BtnBrowseDir" Content="浏览…" Classes="flat" Height="30" VerticalAlignment="Center" Margin="8,0,0,0" Grid.Column="1" Command="{Binding BrowseDirCommand}" />
                                <Button x:Name="BtnScanDir" Content="扫描统计" Classes="flat" Height="30" VerticalAlignment="Center" Margin="8,0,0,0" Grid.Column="2" Command="{Binding ScanDirCommand}" />
                                <Button x:Name="BtnLoadAnnot" Content="加载标注" Classes="flat" Height="30" VerticalAlignment="Center" Margin="8,0,0,0" Grid.Column="3" Click="BtnLoadAnnot_Click" />
                            </Grid>
                            <TextBlock x:Name="ScanInfo" Classes="dimtext" Margin="0,10,0,0"
                                       Text="尚未扫描：点击「扫描统计」查看类别与样本数" />
                            <TextBlock Classes="fainttext" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="目录结构约定：训练集目录 下每个子文件夹为一个类别，子文件夹名就是类别名（建议英文/数字）。支持 .png/.jpg/.jpeg/.bmp/.webp；每类至少 2 张，小样本（每类 50~200 张）效果最佳。" />
                        </StackPanel>
                    </Border>

                    <!-- 2. 标注（主流标注工具样式：大预览 + 缩略图条 + 标注框列表 + 工具行） -->
                    <TextBlock Text="2 标注（可选）：框选目标+标签（人像 / NG 类型识别）" Classes="sectionheader" />
                    <Border Classes="card" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 工具行 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnPickAnnotImg" Content="选择图片…" Classes="flat primary" Height="30" Margin="0,0,4,0" Command="{Binding PickAnnotCommand}" />
                                <Button x:Name="BtnRefreshAnnotList" Content="刷新列表" Classes="flat" Height="30" Margin="4,0,4,0" Grid.Column="1" Command="{Binding RefreshAnnotCommand}" />
                                <Button x:Name="BtnSaveAnnot" Content="保存标注" Classes="flat" Height="30" Margin="4,0,4,0" Grid.Column="2" Command="{Binding SaveAnnotCommand}" />
                                <Button x:Name="BtnClearAnnot" Content="清除全部" Classes="flat" Height="30" Margin="4,0,0,0" Grid.Column="3" Command="{Binding ClearAnnotCommand}" />
                            </Grid>
                            <!-- 图片导航 + 视图切换（参考 labelimage：上一张/下一张/适应窗口） -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnPrevAnnot" Content="◀ 上一张" Classes="flat" Height="30" Margin="0,0,4,0" Click="BtnPrevAnnot_Click" />
                                <Button x:Name="BtnNextAnnot" Content="下一张 ▶" Classes="flat" Height="30" Margin="4,0,4,0" Grid.Column="1" Click="BtnNextAnnot_Click" />
                                <ToggleButton x:Name="BtnViewFit" Content="适应窗口" Classes="flat toggle" Height="30" Margin="4,0,4,0" Grid.Column="2"
                                              IsChecked="True" Checked="BtnViewFit_Changed" Unchecked="BtnViewFit_Changed"
                                              ToolTip.Tip="勾选=图片适应窗口；取消=1:1 实际像素（超出部分被裁剪）" />
                                <TextBlock Grid.Column="3" Text="选中后可移动/缩放/Delete" Classes="fainttext"
                                           VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                                           ToolTip.Tip="单击黄框选中：框内拖动=移动、拖四角=缩放、Delete=删除；右侧列表选中与图上联动" />
                            </Grid>
                            <!-- 大预览：拖框框选目标 -->
                            <Grid Margin="0,8,0,0" ClipToBounds="True" Background="{DynamicResource InputBg}" Height="240">
                                <Image x:Name="AnnotImg" Stretch="Uniform" />
                                <!-- 分层画布（性能）：静态层=已入库框+标签+人脸预填（仅状态变化重建）；
                                     动态层=拖拽中的框/选中高亮+手柄（MouseMove 每帧只更新这层，避免全量重建 3n 个元素） -->
                                <Canvas x:Name="AnnotStaticLayer" IsHitTestVisible="False" Background="Transparent" />
                                <Canvas x:Name="AnnotDynLayer" IsHitTestVisible="False" Background="Transparent" />
                                <Canvas x:Name="AnnotOverlay" Background="Transparent" Focusable="True"
                                        PointerPressed="AnnotOverlay_MouseDown"
                                        PointerMoved="AnnotOverlay_MouseMove"
                                        PointerReleased="AnnotOverlay_MouseUp"
                                        KeyDown="AnnotOverlay_PreviewKeyDown"
                                        ToolTip.Tip="拖空白处框选目标；单击黄框选中，可拖动移动、拖角点缩放、Delete 删除" />
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0">
                                    <TextBlock x:Name="AnnotCurImgName" Classes="fainttext" Text="（未选图）" />
                                    <TextBlock x:Name="AnnotDraftInfo" Classes="fainttext" Text="未框选" />
                                </StackPanel>
                            </Grid>
                            <!-- 图片缩略图条（点选进入标注） -->
                            <ListBox x:Name="AnnotImgList" Height="80" Margin="0,6,0,0"
                                     SelectionChanged="AnnotImgList_SelectionChanged"
                                     ToolTip.Tip="点选图片进入标注；在预览区拖框框住目标">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="2" Padding="3"
                                                Background="{DynamicResource InputBg}" CornerRadius="4">
                                            <StackPanel>
                                                <Image Source="{Binding Converter={StaticResource FileImg}}" Width="60" Height="44"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource FgFaint}"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 标签行 + 统计 -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <AutoCompleteBox x:Name="AnnotLabelBox" Height="34" FontSize="14"
                                          ToolTip.Tip="标签名（姓名 / NG 类型）：下拉选历史标签，或直接输入新标签（自动加入下拉列表）" />
                                <Button x:Name="BtnAddAnnot" Content="添加标注" Classes="flat" Height="30" VerticalAlignment="Center" Margin="6,0,0,0" Grid.Column="1" Command="{Binding AddAnnotCommand}" />
                                <Button x:Name="BtnDelAnnot" Content="删除选中" Classes="flat" Height="30" VerticalAlignment="Center" Margin="6,0,0,0" Grid.Column="2" Command="{Binding DelAnnotCommand}" />
                                <TextBlock x:Name="AnnotStat" Classes="fainttext" Grid.Column="3"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Text="共 0 框"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <!-- 人脸辅助标注行：自动检测人脸预填框（训练人脸/人像识别用）；按钮精简防溢出 -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="AnnotFaceAuto" Content="人脸辅助" VerticalContentAlignment="Center"
                                          Height="30"
                                          ToolTip.Tip="勾选后切换图片自动检测人脸并预填标注框（多人脸各一框），点「预填入库」写入，无需手动拖框"
                                          IsChecked="{Binding FaceAuto}" />
                                <Button x:Name="BtnDetectFaces" Content="检测预填" Classes="flat" Height="30" Margin="6,0,0,0" Grid.Column="1" Command="{Binding DetectFacesCommand}" />
                                <Button x:Name="BtnAddFaceDrafts" Content="预填入库" Classes="flat" Height="30" Margin="6,0,0,0" Grid.Column="2" Command="{Binding AddFaceDraftsCommand}" />
                                <TextBlock x:Name="AnnotFaceStat" Classes="fainttext" Grid.Column="3"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Text="预填 0 框"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <!-- 标注框列表（当前图） -->
                            <ListBox x:Name="AnnotList" Height="96" Margin="0,6,0,0" 
                                     SelectionChanged="AnnotList_SelectionChanged"
                                     ToolTip.Tip="选中后点「删除选中」移除该框；单击图上黄框也可选中" />
                        </StackPanel>
                    </Border>
                    <!-- 3. 训练参数 -->
                    <TextBlock Text="3 训练参数" Classes="sectionheader" />
                    <Border Classes="card" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输入边长" VerticalAlignment="Center" Classes="dimtext" Grid.Row="0" Grid.Column="0" />
                            <TextBox x:Name="SideBox" Text="32" Height="34" FontSize="14" Grid.Row="0" Grid.Column="1" Margin="0,0,12,6"
                                     ToolTip.Tip="正方形输入边长（32 或 64）。越大越慢、小图细节越好" />
                            <TextBlock Text="训练轮数" VerticalAlignment="Center" Classes="dimtext" Grid.Row="0" Grid.Column="2" />
                            <TextBox x:Name="EpochsBox" Text="100" Height="34" FontSize="14" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6" />
                            <TextBlock Text="学习率" VerticalAlignment="Center" Classes="dimtext" Grid.Row="1" Grid.Column="0" />
                            <TextBox x:Name="LrBox" Text="0.003" Height="34" FontSize="14" Grid.Row="1" Grid.Column="1" Margin="0,0,12,6"
                                     ToolTip.Tip="loss 震荡就调低（0.001~0.005 常用）" />
                            <TextBlock Text="批大小" VerticalAlignment="Center" Classes="dimtext" Grid.Row="1" Grid.Column="2" />
                            <TextBox x:Name="BatchBox" Text="8" Height="34" FontSize="14" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" />
                            <TextBlock Text="随机种子" VerticalAlignment="Center" Classes="dimtext" Grid.Row="2" Grid.Column="0" />
                            <TextBox x:Name="SeedBox" Text="20260926" Height="34" FontSize="14" Grid.Row="2" Grid.Column="1" Margin="0,0,12,0"
                                     ToolTip.Tip="固定种子可复现训练结果" />
                            <CheckBox x:Name="AugCheck" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Stretch"
                                      Margin="0,8,0,0" VerticalAlignment="Center" IsChecked="False" HorizontalContentAlignment="Left"
                                      ToolTip.Tip="每轮对样本做随机小平移+亮度抖动。实测 NEU 钢材缺陷 90 张/6 类：开增强 acc 91%→71%（负收益）；拍摄抖动/光照变化大的场景可打开对比。">
                                <TextBlock Text="数据增强（实测表面纹理数据通常掉点，默认关；拍摄抖动/光照变化大的场景可勾上对比）"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Classes="fainttext" Margin="0,4,0,0"
                                       HorizontalAlignment="Left" FontSize="11">
                                <Run Text="学习率余弦衰减：开（60 轮实测 acc 72% → 91%）" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- 右列（同样包 ScrollViewer：训练监控/混淆矩阵/日志超高时可滚动） -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 4. 训练监控 -->
                    <TextBlock Text="4 训练监控" Classes="sectionheader" />
                    <Border Classes="card" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="轮次" Classes="dimtext" VerticalAlignment="Center" />
                                <TextBlock x:Name="ProgText" Classes="monotext" Margin="8,0,0,0" Text="0/0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ProgressBar x:Name="TrainProgress" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,0" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="20,0,10,0">
                                    <TextBlock Text="损失曲线（越低越好）" Classes="fainttext" Margin="0,0,0,2" />
                                    <Canvas x:Name="ChartLoss" Height="100" Background="{DynamicResource InputBg}" ClipToBounds="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="准确率曲线（越高越好）" Classes="fainttext" Margin="0,0,0,2" />
                                    <Canvas x:Name="ChartAcc" Height="100" Background="{DynamicResource InputBg}" ClipToBounds="True" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 5. 混淆矩阵 + 训练摘要 -->
                    <TextBlock Text="5 混淆矩阵" Classes="sectionheader" />
                    <Border Classes="card" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Classes="fainttext" TextWrapping="Wrap"
                                       Text="行 = 真实类别 · 列 = 预测类别；对角绿色 = 预测正确（训练完成后自动生成）。" />
                            <Grid x:Name="CmGrid" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Classes="fainttext" FontSize="11"><Run Text="&#9632; 预测正确  " /><Run Foreground="{DynamicResource FgFaint}" Text="&#9632; 少量混淆  " /><Run Foreground="{DynamicResource FgFaint}" Text="&#9632; 明显混淆" /></TextBlock>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Classes="statcell" Grid.Column="0"><StackPanel><TextBlock Text="训练集准确率" Classes="fainttext" FontSize="11" /><TextBlock x:Name="SumAcc" Classes="monotext" Text="—" /></StackPanel></Border>
                                <Border Classes="statcell" Grid.Column="1" Margin="6,0,0,0"><StackPanel><TextBlock Text="最终损失" Classes="fainttext" FontSize="11" /><TextBlock x:Name="SumLoss" Classes="monotext" Text="—" /></StackPanel></Border>
                                <Border Classes="statcell" Grid.Column="2" Margin="6,0,0,0"><StackPanel><TextBlock Text="耗时" Classes="fainttext" FontSize="11" /><TextBlock x:Name="SumTime" Classes="monotext" Text="—" /></StackPanel></Border>
                                <Border Classes="statcell" Grid.Column="3" Margin="6,0,0,0"><StackPanel><TextBlock Text="样本 / 类别" Classes="fainttext" FontSize="11" /><TextBlock x:Name="SumData" Classes="monotext" Text="—" /></StackPanel></Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 6. 训练日志 -->
                    <TextBlock Text="6 训练日志" Classes="sectionheader" />
                    <Border Classes="card" Margin="0,0,0,12">
                        <TextBox x:Name="TrainLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Text="{Binding LogText}"
                                 Height="190"
                                 FontFamily="{StaticResource MonoFont}" Background="{DynamicResource InputBg}" />
                    </Border>

                    <!-- 说明 -->
                    <TextBlock Text="导出后如何接入「深度学习推理」算子" Classes="sectionheader" />
                    <Border Classes="card" Margin="0,0,0,12">
                        <TextBlock Classes="fainttext" TextWrapping="Wrap"
                                   Text="① 人像/NG 类型识别（一张图识别多个目标）：训练页「标注」区框选目标并填标签（姓名 / NG 类型，建议加「背景」类），保存后点「从标注训练集加载」再训练；导出 ONNX 后，在「视觉」页「深度学习推理」算子任务类型选 2=滑窗多人/多目标识别，模型文件选 model.onnx，标签文件选 labels.txt，输入边长与训练一致（如 32）——识别时会在图上给每个目标画框+标签+坐标。&#10;② 单张图分类：任务类型选 0=分类即可。&#10;③ 不想从头训练：点「加载模型继续训练」选 .vtmodel，再点「开始训练」即接着跑。" />
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
