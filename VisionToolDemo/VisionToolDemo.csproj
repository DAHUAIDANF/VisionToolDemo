<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 允许在 Linux 等非 Windows 环境交叉编译验证（Windows 上无副作用） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Avalonia UI 迁移：跨平台（Windows + Linux），替代原 WPF 界面 -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>VisionToolDemo</RootNamespace>
    <AssemblyName>VisionToolDemo</AssemblyName>
    <ApplicationIcon>APP.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI 框架（MIT 许可，免费开源可商用，跨 Windows/Linux/macOS） -->
    <PackageReference Include="Avalonia" Version="11.3.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260427" />
    <!-- OpenCvSharp 原生库：Windows 用 4.13（含 SimpleBlobDetector 所需导出）；
         Linux 运行时包最新为 4.10（NuGet 未跟进 4.13），常用算子 API 兼容 -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.linux-x64" Version="4.10.0.20240717" />
    <!-- 截屏：Windows 用 System.Drawing.Common（GDI+）；Linux 用 X11 适配（见 ScreenCapture） -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- Ecc200Decoder 复用 ZXing 的公开 API（DefaultPlacement 位排布 + RS 纠错） -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <!-- 相机 RAW 照片解码（Windows 原生；Linux 需 Magick.Native 对应平台库） -->
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.17.1" />
    <!-- Tesseract OCR 增强引擎（Windows 原生；Linux 需系统 tesseract/leptonica） -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <!-- ONNX Runtime（内置 win-x64 与 linux-x64 原生库，跨平台） -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
  </ItemGroup>

  <!-- OpenCvSharp 原生库显式拷贝到输出根（普通构建不带 RID 时不自动复制 runtimes/ 下 native） -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)opencvsharp4.runtime.win\4.13.0.20260627\runtimes\win-x64\native\OpenCvSharpExtern.dll" Link="OpenCvSharpExtern.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' != 'linux-x64'" />
    <None Include="$(NuGetPackageRoot)opencvsharp4.runtime.win\4.13.0.20260627\runtimes\win-x64\native\opencv_videoio_ffmpeg4130_64.dll" Link="opencv_videoio_ffmpeg4130_64.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' != 'linux-x64'" />
    <None Include="$(NuGetPackageRoot)opencvsharp4.runtime.linux-x64\4.10.0.20240717\runtimes\linux-x64\native\libOpenCvSharpExtern.so" Link="libOpenCvSharpExtern.so" CopyToOutputDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
  </ItemGroup>

  <ItemGroup>
    <!-- ===== Avalonia 迁移阶段标记 =====
         已迁移文件正常参与构建；以下"尚未迁移"的 WPF 页面/窗口/辅助类暂时排除编译。
         每迁移完成一个文件就从本组摘出（删除对应 Remove 行），全部完成后删除整个 ItemGroup。
         已迁移：Mvvm、Ui、ThemeManager、MainWindow.axaml/.cs、Styles.axaml、Themes/*.axaml、IShellPage -->
    <Compile Remove="Wpf\Views\**" />
    <Compile Include="Wpf\Views\SettingsPage.axaml.cs" />   <!-- 已迁移页：从 Views 排除中重新纳入编译 -->
    <Compile Include="Wpf\Views\HelpPage.axaml.cs" />
    <Compile Include="Wpf\Views\HistoryPage.axaml.cs" />
    <Compile Include="Wpf\Views\CatalogPage.axaml.cs" />
    <Compile Include="Wpf\Views\CapturePage.axaml.cs" />
    <Compile Include="Wpf\Views\TrainPage.axaml.cs" />       <!-- 训练页已迁移 -->
    <Compile Include="Wpf\Views\PipelinePage.axaml.cs" />     <!-- 流水线页已迁移 -->
    <Compile Include="Wpf\Views\AutomationPage.axaml.cs" />    <!-- 自动化页已迁移（VisionMaster 风格实例属性） -->
    <Compile Remove="Wpf\Views\AutomationPage.xaml" />       <!-- 旧 WPF 自动化页 -->
    <Compile Remove="Wpf\Views\AutomationPage.xaml.cs" />    <!-- 旧 WPF 自动化页 code-behind -->
    <!-- AutomationViewModel.cs 默认自动包含，无需显式 Include -->
    <Compile Remove="Wpf\Views\CapturePage.xaml" />       <!-- 旧 WPF 采集页，迁移完成后删除 -->
    <Compile Remove="Wpf\Views\TrainPage.xaml" />         <!-- 旧 WPF 训练页 -->
    <Compile Remove="Wpf\Views\TrainPage.xaml.cs" />
    <!-- Vision 层 Windows UIA 自动化节点（浏览器元素/弹窗），跨平台适配时迁移 -->
    <Compile Remove="Vision\Tasks\PopupTask.cs" />
    <Compile Remove="Vision\Tasks\BrowserElementTask.cs" />
    <Compile Remove="Wpf\TrackPreviewWindow.xaml.cs" />  <!-- 旧 WPF 跟踪窗 code-behind（axaml.cs 已替代） -->
    <Compile Remove="Wpf\MainWindow.xaml" />            <!-- 旧 WPF XAML 不进构建 -->
    <Compile Remove="Wpf\Styles.xaml" />               <!-- 旧 WPF 样式源，保留作参考 -->
    <Compile Remove="Wpf\Views\PipelinePage.xaml.bak" />
    <Compile Remove="Wpf\Views\PipelinePage.xaml.cs.bak" />
    <EmbeddedResource Remove="Wpf\Views\**" />
    <EmbeddedResource Remove="Wpf\MainWindow.xaml" />
    <EmbeddedResource Remove="Wpf\TrackPreviewWindow.xaml" />
    <EmbeddedResource Remove="Wpf\Styles.xaml" />
    <None Remove="Wpf\Views\**" />
    <None Remove="Wpf\MainWindow.xaml" />
    <None Remove="Wpf\Styles.xaml" />
    <None Remove="Wpf\TrackPreviewWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="APP.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 人脸检测 Haar 级联模型（OpenCV 开源，BSD 可商用） -->
    <Content Include="Vision\haarcascade_frontalface_default.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>haarcascade_frontalface_default.xml</Link>
    </Content>
    <!-- YuNet 人脸检测 ONNX 模型（OpenCV Zoo 官方，Apache-2.0 可商用） -->
    <Content Include="Vision\face_detection_yunet_2023mar.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>face_detection_yunet_2023mar.onnx</Link>
    </Content>
    <!-- Tesseract 语言包 -->
    <Content Include="tessdata\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tessdata\%(Filename)%(Extension)</Link>
    </Content>
    <!-- 软件使用图文手册的界面截图（16 张） -->
    <Content Include="..\docs\img\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>docs\img\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
